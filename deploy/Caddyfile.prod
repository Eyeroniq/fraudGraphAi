# Production: Caddy gets and renews a certificate for FG_DOMAIN on its own (ports 80 and
# 443 must reach this host). Public demo mode: the key Caddy injects is read-only, so
# visitors can browse but not score, label, promote or drive the simulator.
{
	email {$FG_ACME_EMAIL}
}

{$FG_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/metrics {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-API-Key {$FG_WEB_API_KEY}
		}
	}

	handle {
		root * /srv
		@static path /_next/static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}
