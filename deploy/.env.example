# Copy to deploy/.env (git-ignored) and fill in. Secrets live only here, never in YAML.
# Make keys with `uv run fgx api-key --scope <read|write|admin>`: the key goes to the
# client, the `scope:hash` entry goes into FG_API__API_KEYS.

POSTGRES_PASSWORD=change-me

# Comma-separated scope:sha256 entries, e.g. write:<hash>,admin:<hash>
FG_API__API_KEYS=

# The web page's key (plain), injected by Caddy; its hash must be in FG_API__API_KEYS.
FG_WEB_API_KEY=
