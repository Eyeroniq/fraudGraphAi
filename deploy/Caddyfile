# Local stack: plain HTTP on 8080. Production (automatic HTTPS on a domain) uses
# Caddyfile.prod via docker-compose.prod.yml.
:8080 {
	encode gzip

	# Prometheus metrics stay on the internal network (scraped at api:8000/metrics).
	handle /api/metrics {
		respond 404
	}

	# Same origin for page and API, so no CORS in production (D9).
	# The page is the API's client: Caddy adds its key (FG_WEB_API_KEY, from .env) so
	# the key never ships in the static bundle. The WebSocket gets it the same way.
	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-API-Key {$FG_WEB_API_KEY}
		}
	}

	handle {
		root * /srv
		@static path /_next/static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}
